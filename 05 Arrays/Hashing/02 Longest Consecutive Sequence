class Solution:
    def longestConsecutive(self, nums: list[int]) -> int:
        if not nums:
            return 0
        
        nums.sort()
        
        curr_len = 1
        max_len = 1
        

        for i in range(1, len(nums)):
            if nums[i] == nums[i-1]:
                continue
            
            if nums[i] == nums[i-1]+1:
                curr_len +=1
            else:
                max_len = max(curr_len, max_len)
                curr_len = 1
        
        return max(max_len, curr_len)
            
        